# ==============================================================================
# WanderAI Backend Production & Development Environment Configuration
# Set these variables in the Render Dashboard (Web Service -> Environment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER & FLASK RUNTIME (Set in Render Environment Variables)
# ------------------------------------------------------------------------------
# Production environment setting
FLASK_ENV=
FLASK_DEBUG=
HOST=
PORT=

# ------------------------------------------------------------------------------
# 2. MONGODB ATLAS DATABASE (Required in Render)
# ------------------------------------------------------------------------------
# Connection string from MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=
DB_NAME=

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (Required in Render - minimum 32 hex characters)
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRY_HOURS=

# ------------------------------------------------------------------------------
# 4. AI AGENTS & PROVIDERS (Required in Render for AI Itinerary Generation)
# ------------------------------------------------------------------------------
# AI Provider: 'gemini' (default) or 'groq'
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=

# Groq API for Preference Ranking and high-speed fallback
GROQ_API_KEY=
GROQ_MODEL=

# ------------------------------------------------------------------------------
# 5. FRONTEND CORS (Required in Render)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. https://your-app.vercel.app)
# Localhost origins (http://localhost:5173, etc.) are automatically preserved for dev
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# 6. EXTERNAL TRAVEL SERVICES & APIS
# ------------------------------------------------------------------------------
# Pixabay Image API (Dynamic destination hero photography)
# Key from https://pixabay.com/api/docs/
IMAGE_API_KEY=
PIXABAY_API_KEY=

# SerpApi Google Flights & Google Hotels Search API
# Key from https://serpapi.com
FLIGHT_API_KEY=
FLIGHT_API_SECRET=
HOTEL_API_KEY=

# Maps & Routing (Uses OpenStreetMap & OSRM public demo server; MAPS_API_KEY optional/blank)
MAPS_API_KEY=

# Currency Exchange (Uses Frankfurter v2 API; free open service, no key required)
CURRENCY_API_KEY=

# Weather & Inclement Weather Replanning (Uses Open-Meteo; free service, no key required)
WEATHER_API_KEY=
